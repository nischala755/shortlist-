generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CANDIDATE
  RECRUITER
  HIRING_MANAGER
  INTERVIEWER
  ADMIN
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  SHORTLISTED
  ASSESSMENT
  INTERVIEW
  OFFER
  HIRED
}

enum EvidenceSource {
  RESUME
  INTERVIEW
  ASSESSMENT
  MANUAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  jobs        Job[]
  candidates  Candidate[]
  applications Application[]
  resumes     Resume[]
  candidateEvidence CandidateEvidence[]
  interviews   Interview[]

  @@index([name])
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  email       String       @unique
  passwordHash String
  emailVerifiedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  sessions     Session[]
  verificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  createdJobs Job[] @relation("JobCreatedBy")
  createdCandidates Candidate[] @relation("CandidateCreatedBy")
  uploadedResumes Resume[] @relation("ResumeUploadedBy")
  resumeAnalyses ResumeAnalysis[] @relation("ResumeAnalysisRequestedBy")
  createdEvidence CandidateEvidence[] @relation("EvidenceCreatedBy")
  createdInterviews Interview[] @relation("InterviewCreatedBy")
  assignedInterviews Interview[] @relation("InterviewAssignedTo")
  applications Application[] @relation("ApplicationCreatedBy")
  applicationStageChanges ApplicationStageHistory[] @relation("ApplicationStageChangedBy")
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           Role         @default(CANDIDATE)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  createdById    String    @db.Uuid
  title          String
  description    String
  status         JobStatus @default(DRAFT)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User      @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  requirements   JobRequirement[]
  applications   Application[]

  @@index([organizationId, status])
  @@index([createdById])
}

model Candidate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  createdById    String   @db.Uuid
  name           String
  email          String
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User     @relation("CandidateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  applications   Application[]
  resumes        Resume[]
  evidence       CandidateEvidence[]

  @@unique([organizationId, email])
  @@index([organizationId, name])
}

model JobRequirement {
  id          String   @id @default(uuid()) @db.Uuid
  jobId       String   @db.Uuid
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  evidence    CandidateEvidence[]

  @@unique([jobId, title])
  @@index([jobId])
}

model Application {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  jobId          String           @db.Uuid
  candidateId    String           @db.Uuid
  createdById    String           @db.Uuid
  currentStage   ApplicationStage @default(APPLIED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job            Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate      Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("ApplicationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  stageHistory   ApplicationStageHistory[]
  interviews     Interview[]

  @@unique([jobId, candidateId])
  @@index([organizationId, currentStage])
  @@index([candidateId])
}

model ApplicationStageHistory {
  id            String           @id @default(uuid()) @db.Uuid
  applicationId String           @db.Uuid
  changedById   String           @db.Uuid
  fromStage     ApplicationStage?
  toStage       ApplicationStage
  changedAt     DateTime         @default(now())
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy     User             @relation("ApplicationStageChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([applicationId, changedAt])
}

model Resume {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  candidateId    String   @db.Uuid
  uploadedById   String   @db.Uuid
  originalName   String
  storageKey     String   @unique
  mimeType       String
  sizeBytes      Int
  sha256         String
  parsedText     String?  @db.Text
  parsedAt       DateTime?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  uploadedBy     User     @relation("ResumeUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  analysis       ResumeAnalysis?

  @@index([organizationId, candidateId])
}

model Interview {
  id            String          @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  applicationId String          @db.Uuid
  interviewerId String          @db.Uuid
  createdById   String          @db.Uuid
  scheduledStart DateTime
  scheduledEnd   DateTime
  location      String?
  meetingUrl    String?
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer   User            @relation("InterviewAssignedTo", fields: [interviewerId], references: [id], onDelete: Restrict)
  createdBy     User            @relation("InterviewCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, scheduledStart])
  @@index([interviewerId, scheduledStart])
  @@index([applicationId, scheduledStart])
}

model CandidateEvidence {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @db.Uuid
  candidateId       String         @db.Uuid
  createdById       String         @db.Uuid
  jobRequirementId  String?        @db.Uuid
  title             String
  details           String         @db.Text
  sourceType        EvidenceSource
  sourceReference   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate         Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdBy         User            @relation("EvidenceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  jobRequirement    JobRequirement? @relation(fields: [jobRequirementId], references: [id], onDelete: SetNull)

  @@index([organizationId, candidateId, createdAt])
  @@index([jobRequirementId])
}

model ResumeAnalysis {
  id            String   @id @default(uuid()) @db.Uuid
  resumeId      String   @unique @db.Uuid
  requestedById String   @db.Uuid
  provider      String
  model         String
  analysisJson  Json
  createdAt     DateTime @default(now())
  resume        Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  requestedBy   User     @relation("ResumeAnalysisRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([requestedById])
}
